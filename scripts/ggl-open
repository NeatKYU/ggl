#!/bin/sh
# 터미널에서 저장소 열기:  ggl-open [--files] [폴더]   (폴더를 안 주면 현재 폴더)
#   --files  왼쪽 파일 트리를 펼친 채로 연다
# 같은 저장소를 연 ggl 창이 있으면 새 창을 띄우지 않고 그 창을 앞으로 가져온다.
# (oh-my-zsh는 `ggl`을 git pull 단축어로 쓰기 때문에 명령 이름을 ggl-open으로 했다)
files=""
if [ "${1:-}" = "--files" ]; then
  files="--files"
  shift
fi
dir="$(cd "${1:-.}" && pwd)" || exit 1

# 떠 있는 창에 먼저 넘겨 본다. 앱을 거치지 않고 실행 파일을 바로 부르면 Dock 아이콘이 깜빡이지 않는다.
for app in "$HOME/Applications/ggl.app" "/Applications/ggl.app"; do
  if [ -x "$app/Contents/MacOS/ggl" ]; then
    "$app/Contents/MacOS/ggl" --hand-off $files "$dir" && exit 0
    break
  fi
done
exec open -n -a "ggl" --args $files "$dir"
